modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
WHOP_COMPANY_ID = "biz_AkaNOYEhAyYo0V"
WHOP_PLAN_ID = "plan_CYV6n06EK7y0Z"
WHOP_PRODUCT_ID = "prod_jdqgC3DWWQLEO"
VITE_API_BASE_URL = "https://pepscan.replit.app"
VITE_REVENUECAT_API_KEY = "test_qyXJnrdLXTJhARfJDQUkVFHdcMA"
VITE_APPSFLYER_DEV_KEY = "JSLgHsBXaiTvbDDMmXwLG8"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 22989
externalPort = 80
